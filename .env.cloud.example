# Set these in the hosting provider's secret/environment UI, not in GitHub.
DEPLOYMENT_MODE=public
API_KEY=
DB_PATH=/app/data/flights.db
# Railway: attach a volume at /app/data. Its runtime mount starts as root;
# start.py prepares only this directory, then drops to uid 10001.
RAILWAY_RUN_UID=0
AUTOSCAN_ENABLED=false
SCAN_INTERVAL_SECONDS=300
SCAN_BATCH_SIZE=3
SCAN_TIMEOUT_SECONDS=180
NTFY_ENABLED=false
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
