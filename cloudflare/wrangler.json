{
  "name": "ai-flight-radar-cf",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "APP_ID": "reese-max/ai-flight-radar:cloudflare-v1",
    "COLLECTOR_ENABLED": "true",
    "MAX_SEARCHES_PER_HOUR": "3"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-flight-radar-cf",
      "database_id": "acc694a8-3da6-411a-baa8-9e1ee860918c",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
