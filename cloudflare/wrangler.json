{
  "name": "ai-flight-radar-cf",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "APP_ID": "reese-max/ai-flight-radar:cloudflare-v1",
    "COLLECTOR_ENABLED": "false",
    "MAX_SEARCHES_PER_HOUR": "3",
    "CALIBRATION_ADMISSION": "{\"schema_version\":1,\"protocol_version\":\"1.0\",\"provider\":\"fast_flights\",\"provider_version\":\"3.1.0\",\"decision\":\"BLOCK\",\"measured_at\":null,\"expires_at\":null,\"allowed_routes\":[],\"route_metrics\":{},\"approvals\":{\"owner_authorized\":false,\"terms_allowed\":false,\"budget_approved\":false},\"blockers\":[\"owner_authorized_live_calibration_not_completed\"]}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-flight-radar-cf",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
