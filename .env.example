# Copy to .env; never commit real credentials. Existing shell variables win.
# DB_PATH=data/flights.db
API_HOST=127.0.0.1
API_PORT=8787
# Protect write endpoints when exposed through a trusted HTTPS proxy.
API_KEY=
NTFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
# Use your own access-controlled/reserved topic, not a shared public topic.
NTFY_TOPIC=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Provider selection (Issue #8): primary stays fast_flights until calibration
# evidence is reviewed; fli selects the vendored Fli-derived engine.
# RADAR_PRIMARY_PROVIDER=fast_flights
# RADAR_FALLBACK_PROVIDER=fast_flights
# RADAR_CALIBRATION_ENABLED=false
